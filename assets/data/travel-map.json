---
layout: null
---
{%- comment -%}
  Everything the travel map script needs, built from _data/travel_map.yml (points and labels) and
  _data/travel_routes.json (route lines).
{%- endcomment -%}
{%- assign map = site.data.travel_map -%}
{
  "origins": [
    {%- for o in map.origins %}
    {
      "label": {{ o.label | jsonify }},
      "icons": {{ o.icons | jsonify }},
      "latlng": [{{ o.lat }}, {{ o.lng }}],
      "side": {{ o.side | default: "right" | jsonify }},
      "routes_side_narrow": {{ o.routes_side_narrow | jsonify }},
      "nudge": {{ o.nudge | default: 0 }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  "destination": {{ map.destination | jsonify }},
  "places": [
    {%- for p in map.places %}
    {
      "id": {{ p.id | jsonify }},
      "label": {{ p.label | jsonify }},
      "icons": {{ p.icons | jsonify }},
      "latlng": [{{ p.lat }}, {{ p.lng }}],
      "side": {{ p.side | default: "right" | jsonify }},
      "routes_side": {{ p.routes_side | default: p.side | default: "right" | jsonify }},
      "routes_side_narrow": {{ p.routes_side_narrow | jsonify }},
      "nudge": {{ p.nudge | default: 0 }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  "south": {{ map.south | jsonify }},
  "routes": {{ site.data.travel_routes | jsonify }}
}
